  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="3084" net="1">
        <attribute name="Name" id="3085" net="1">
          <![CDATA[Hard hat boogie-woogie]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3086" net="1">
          <![CDATA[An original boogie-woogie in C for a building site's Friday finish: after a pickup, the piano's right hand, its rolling left-hand bass and drums with a hammer hit play each four-bar section of a 12-bar chorus in parallel, then the band repeats the chorus, plays a stop-time hammer break or plays the ending.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
