  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2322" net="1">
        <attribute name="Name" id="2323" net="1">
          <![CDATA[Messaging app group chat]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2324" net="1">
          <![CDATA[A messaging app's group chat: creating a group with invites and offline retries, end-to-end key exchange, incoming messages counted as unread up to four with notification banners suppressed when muted (inhibitor arcs), reading that clears the badge (reset arcs), text, photo and voice messages with upload failures and an offline outbox, per-member delivery to two phones in parallel with double and blue ticks, reactions, replies and delete for everyone, and group info with muting, adding and removing members with key rotation, and leaving the group.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
