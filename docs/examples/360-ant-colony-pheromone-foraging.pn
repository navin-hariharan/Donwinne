  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1427" net="1">
        <attribute name="Name" id="1428" net="1">
          <![CDATA[Ant colony foraging with pheromone trails]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1429" net="1">
          <![CDATA[Three forager ants sharing food sources and a pheromone trail: scouts search at random only while no trail exists (inhibitor arc), recruits follow an existing trail (read arc), successful foragers reinforce the trail up to a cap while it evaporates and rain wipes it (reset arc), competition for the last food portions, rival encounters, a spider that takes a forager and a queen-laid replacement raised from stored food, a capped food store with trophallaxis, and nest digging and midden work.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
