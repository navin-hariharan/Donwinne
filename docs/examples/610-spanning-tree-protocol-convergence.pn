  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1642" net="1">
        <attribute name="Name" id="1643" net="1">
          <![CDATA[Spanning Tree Protocol convergence]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1644" net="1">
          <![CDATA[A switch running the Spanning Tree Protocol: ports start blocking, root bridge election by BPDU, path-cost comparison and port roles, root and designated ports moving through listening, learning and forwarding in parallel while the alternate port discards, MAC learning capped by an inhibitor, known-unicast forwarding and flooding, MAC aging, hello BPDUs, BPDU guard err-disabling an edge port, RSTP alternate-port failover with topology change flushing the MAC table (reset arc), and legacy max-age reconvergence.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
