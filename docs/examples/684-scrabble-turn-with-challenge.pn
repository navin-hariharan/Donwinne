  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2403" net="1">
        <attribute name="Name" id="2404" net="1">
          <![CDATA[Scrabble turns with challenges]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2405" net="1">
          <![CDATA[Scrabble turns: laying one to three tiles from the rack, picking tiles back up, exchanging or passing, the opponent accepting or challenging against the dictionary, phonies taken back, tiles fixed to the board, letter values, premium squares and the bingo bonus scored in parallel, refilling from the bag, the opponent's turn with its own challenge, going out, a parallel final tally and returning every tile to the bag for a new game.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
