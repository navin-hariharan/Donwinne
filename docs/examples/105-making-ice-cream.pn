  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1514" net="1">
        <attribute name="Name" id="1515" net="1">
          <![CDATA[Making ice cream]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1516" net="1">
          <![CDATA[Making custard-based vanilla ice cream: freezing the churn bowl in parallel with the custard, infusing milk and cream, tempering yolks, cooking with thin and curdled custard recoveries, straining and chilling, churning with a re-chill retry, optional chocolate chips, hardening in the freezer and serving.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
