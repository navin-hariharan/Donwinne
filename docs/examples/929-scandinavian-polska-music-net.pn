  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="3231" net="1">
        <attribute name="Name" id="3232" net="1">
          <![CDATA[Scandinavian folk polska]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3233" net="1">
          <![CDATA[An original Scandinavian folk polska in 3/4 as a music net: a drone and stomped count-in, an A part and a B part in D minor where a bowed nyckelharpa-like melody, a string drone and foot-stomp percussion play in parallel, repeats of either part, a return from B to A, and a closing phrase that leads back to the start.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
