  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1606" net="1">
        <attribute name="Name" id="1607" net="1">
          <![CDATA[Streaming event processing]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1608" net="1">
          <![CDATA[A stream processor consuming events from a partition: a capped backlog (inhibitor arc), schema registry decoding with dead-letter routing for poison events, idempotent duplicate skipping, profile and geo enrichment in parallel with a database circuit breaker that counts timeouts (read, inhibitor and reset arcs), tumbling windows that count events, close on the watermark and are flushed and cleared (reset arc), late events as corrections or side output, offset commits with retries and rebalances that flush and restore the state store, and a consumer-lag alert.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
