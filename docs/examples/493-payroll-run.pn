  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2848" net="1">
        <attribute name="Name" id="2849" net="1">
          <![CDATA[Monthly payroll run]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2850" net="1">
          <![CDATA[A monthly payroll run: HR changes, timesheets with capped manager chases and pay variations gathered in parallel, gross-to-net calculation, parallel variance, negative-pay and minimum-wage checks with an exception list cleared by a reset arc, manager and finance director approval, a lock that waits for late HR changes (inhibitor arc), bank payments, tax filing, pension contributions and payslips in parallel, pay queries, off-cycle payments and control account reconciliation.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
