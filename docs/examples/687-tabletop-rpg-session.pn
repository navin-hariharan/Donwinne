      <metadata id="3108" net="1">
        <attribute name="Name" id="3109" net="1">
          <![CDATA[Tabletop role-playing session]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3110" net="1">
          <![CDATA[A tabletop role-playing session: parallel GM prep with encounter rebalancing, cancellations, recap and safety tools, a tavern scene with persuasion rolls that reveal a clue or start a brawl, a crypt with trap searches, disarming and darts, combat with initiative, sword hits, fireballs, magic missiles, healing, fleeing monsters, unconsciousness, death saves and party wipes, parallel loot and milestone XP with level-ups, short rests, and a parallel wrap-up with sheets, notes and a date poll before the long rest.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
