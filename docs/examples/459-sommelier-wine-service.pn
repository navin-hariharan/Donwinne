        <attribute name="Name" id="1703" net="1">
          <![CDATA[Sommelier wine service]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1704" net="1">
          <![CDATA[Wine service by a sommelier at the table: the wine list and food pairing, wine by the glass from a Coravin or a bottle checked against the cellar inventory, chilling whites, presenting the label with wrong vintages swapped, pulling the cork with a broken cork rescued, the host tasting with corked bottles logged and replaced, decanting old reds while the glasses are set, topping up, a second bottle or dessert wine, and billing with the cellar inventory updated.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
