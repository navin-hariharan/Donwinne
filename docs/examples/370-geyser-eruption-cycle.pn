  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1235" net="1">
        <attribute name="Name" id="1236" net="1">
          <![CDATA[Geyser eruption cycle]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1237" net="1">
          <![CDATA[A geyser's eruption cycle: groundwater refills the conduit and shallow magma heats it (inhibitor-capped counters read by the trigger), rain cools the pool, the column superheats, steam bubbles jam in a sinter constriction or escape as preplay, overflow drops the pressure and flash boiling starts the eruption, the water jet drains the column until an inhibitor arc switches to the steam phase that resets the heat, tremor and runoff temperature are recorded in parallel with webcam backups, and the interval is logged and the next eruption predicted.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
