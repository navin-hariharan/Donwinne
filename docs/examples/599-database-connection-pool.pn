      <metadata id="1403" net="1">
        <attribute name="Name" id="1404" net="1">
          <![CDATA[Database connection pool]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1405" net="1">
          <![CDATA[A database connection pool with a maximum of three connections: capped request queue, borrowing idle connections, on-demand opening with handshake failures and backoff, borrow timeouts when the pool is exhausted, validation of stale connections, queries with statement timeouts and lost connections, leak detection and forced close, response streaming in parallel with session reset, housekeeping that evicts above the minimum idle, retires old connections and refills, and primary failover that rejects waiting borrowers (reset arc), with an exhaustion alert.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
