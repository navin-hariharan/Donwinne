      <metadata id="1836" net="1">
        <attribute name="Name" id="1837" net="1">
          <![CDATA[New language model release with evaluation gates and canary]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1838" net="1">
          <![CDATA[Releasing a new language model version: benchmark, red-team and customer regression gates in parallel with fix loops, a release board, a change freeze that blocks deployment (inhibitor arc), shadow traffic in parallel with human preference rating, a staged canary whose stage counter is capped with inhibitor arcs and cleared with reset arcs, automatic rollback with on-call incidents and hotfixes, and the model card, changelog and retirement of the old version.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
