  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2431" net="1">
        <attribute name="Name" id="2432" net="1">
          <![CDATA[Warehouse robots picking and packing orders]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2433" net="1">
          <![CDATA[Order fulfilment in a robotic warehouse: a capped order queue, stock checks and backorders, two pick tasks served by a pool of two robots competing for an aisle intersection, a pick station and one charging dock, obstacles, faults and an emergency stop (inhibitor arcs), picking with wrong items and empty bins, box erection in parallel, weighing, audits, labels, sorting to express or standard lanes, and supplier replenishment.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
