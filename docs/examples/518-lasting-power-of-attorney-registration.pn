  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1523" net="1">
        <attribute name="Name" id="1524" net="1">
          <![CDATA[Lasting power of attorney registration]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1525" net="1">
          <![CDATA[Making and registering a lasting power of attorney: choosing the type, attorneys, certificate provider and people to notify in parallel, signing in order with a capacity and pressure check, notices, registration with returned forms, a waiting period in which capped objections must all be resolved before registration (inhibitor arcs) or an upheld objection that clears the rest (reset arc), then attorneys acting with a capped decision log, investigations, revocation and the end of the LPA that closes the log (reset arcs).]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
