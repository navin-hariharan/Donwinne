  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2227" net="1">
        <attribute name="Name" id="2228" net="1">
          <![CDATA[Sheet metal stamping on a progressive die press]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2229" net="1">
          <![CDATA[A coil-fed progressive die stamping run: die change, coil loading and die sensor setup in parallel, shut height and feed pitch, first-off approval with burr and hole position rework, press strokes counted into bins and inhibited by a light curtain, misfeeds, slug pulling and coil splices, bin audits with sorting, bin and order counters cleared by reset arcs, and a parallel teardown with die wear inspection and regrinding.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
