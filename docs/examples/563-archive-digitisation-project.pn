  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2162" net="1">
        <attribute name="Name" id="2163" net="1">
          <![CDATA[Archive digitisation project]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2164" net="1">
          <![CDATA[Digitising an archive box: copyright and orphan-works checks, conservation assessment and repair, scanner calibration against a colour target, three pages scanned and quality-checked as tokens with a capped rescan tally, scanner faults that block scanning (inhibitor arcs), metadata and authority records in parallel, OCR or volunteer transcription, ingest with fixity and format checks, offsite replication in parallel with publication or closure, and returning the boxes.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
