    <metadataclass count="1" name="General">
      <metadata id="1299" net="1">
        <attribute name="Name" id="1300" net="1">
          <![CDATA[Lake-effect snow event]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1301" net="1">
          <![CDATA[Lake-effect snow over the Great Lakes: arctic outbreaks over a warm lake, weak contrasts that give only cloud, heat and moisture fluxes from the lake in parallel with upwind lake preconditioning, shallow flurries, a single intense band along the long fetch or multiple bands, band shifts, upslope enhancement over a plateau and thundersnow, repeated outbreaks, the lake cooling and icing over, and the spring thaw.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
