      <metadata id="2862" net="1">
        <attribute name="Name" id="2863" net="1">
          <![CDATA[Insurance claim processing]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2864" net="1">
          <![CDATA[An insurance claim from loss to renewal: notification by phone, online or broker, registration and cover check, parallel document collection, fraud screening with investigation and reserve setting, desk or loss adjuster assessment, repair, cash or total loss settlement with disputes, complaints and the ombudsman, payment with failures, parallel subrogation and feedback, and declines with appeals.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
