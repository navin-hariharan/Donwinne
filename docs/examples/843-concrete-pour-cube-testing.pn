  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2738" net="1">
        <attribute name="Name" id="2739" net="1">
          <![CDATA[Concrete pour with cube testing]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2740" net="1">
          <![CDATA[A structural concrete pour: parallel formwork, reinforcement and pump checks, the pour permit, delivery ticket and slump tests with rejected loads, test cubes made in parallel with the first discharge, pump blockages and formwork movement, further truck loads, finishing and curing, 7-day and 28-day cube tests, propped slabs, cores, engineer assessment and break-out and recast.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
