  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1242" net="1">
        <attribute name="Name" id="1243" net="1">
          <![CDATA[How a car engine works]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1244" net="1">
          <![CDATA[A petrol engine with ignition, ECU self-test, fuel pump and starter motor, the four strokes with misfires, flywheel momentum and engine heat, cooling, check-engine and overheat warnings, fuel running out and stalling. Inhibitor arcs stop the starter on a running engine and cap misfires, momentum and heat; reset arcs clear fault codes and running state after a stall or shutdown.]]>
          <graphics count="0"/>
        </attribute>
