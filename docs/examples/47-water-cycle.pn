  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1497" net="1">
        <attribute name="Name" id="1498" net="1">
          <![CDATA[The water cycle]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1499" net="1">
          <![CDATA[The water cycle followed by one parcel of water: evaporation, condensation over sea or land, rain or snow, canopy interception, lakes, transpiration, surface runoff and groundwater flowing to the sea in parallel, snowpack, sublimation, melt and glaciers.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
