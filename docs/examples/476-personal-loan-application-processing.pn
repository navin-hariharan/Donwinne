  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="3155" net="1">
        <attribute name="Name" id="3156" net="1">
          <![CDATA[Personal loan application processing]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3157" net="1">
          <![CDATA[Processing a personal loan application: soft eligibility check and quotes, the full application with a hard credit search, parallel credit scoring with thin-file alternative data, affordability from open banking or uploaded payslips with a stress test, and fraud screening, automated or underwriter decisions with information requests and counter-offers, pre-contract information and e-signature, payee name checks, parallel payout, repayment schedule and welcome pack, cooling-off withdrawal, monthly repayments with early settlement, arrears contact, payment plans, default and recovery.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
