      <metadata id="1376" net="1">
        <attribute name="Name" id="1377" net="1">
          <![CDATA[Human heart and blood circulation]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1378" net="1">
          <![CDATA[The heart beat and blood circulation: the SA node, atrial contraction, AV node delay and Purkinje fibres, ventricles ejecting into the pulmonary and systemic circuits in parallel, gas exchange in the lungs, blood supply to the brain, muscles, kidneys and heart wall, venous return and filling in diastole, and baroreceptor, vagal and adrenaline control of the next beat.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
