  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2173" net="1">
        <attribute name="Name" id="2174" net="1">
          <![CDATA[Airport baggage handling system]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2175" net="1">
          <![CDATA[A hold bag through an airport baggage handling system: check-in or transfer induction with a hot tail-to-tail path for tight connections, the baggage source message processed in parallel, belt jams, barcode and RFID reads with a two-misread limit before manual coding (inhibitor, read and reset arcs), level 1 to level 3 hold baggage screening with hand searches, sorter routing, early bag storage and misroutes, reconciliation at make-up with offloads, containers that leave when they hold two bags, part-full containers dispatched when the flight closes, and an emergency stop that halts induction, screening and sorting.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
