  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2901" net="1">
        <attribute name="Name" id="2902" net="1">
          <![CDATA[Rice paddy cultivation season]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2903" net="1">
          <![CDATA[A smallholder rice paddy season: ploughing and bund repairs, a seed nursery and land preparation by canal flooding and puddling in parallel, transplanting, water, nutrient (leaf colour chart) and pest management in parallel, grain filling with birds and lodging, sickle or combine harvesting, threshing, sun drying with moisture tests, and selling and household milling in parallel before the straw is ploughed in.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
