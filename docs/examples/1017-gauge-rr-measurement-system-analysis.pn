  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1915" net="1">
        <attribute name="Name" id="1916" net="1">
          <![CDATA[Gauge R&R measurement system analysis]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1917" net="1">
          <![CDATA[A measurement system analysis: checking gauge calibration, selecting and blind-coding parts, then either a crossed variable gauge R&R with three appraisers sharing one gauge over two trials, ANOVA, distinct category checks and acceptance at under 10, 10 to 30 or over 30 percent with fixture improvement or appraiser retraining, or an attribute agreement study with two inspectors and kappa, ending with an MSA report and gauge release.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
