  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="3997" net="1">
        <attribute name="Name" id="3998" net="1">
          <![CDATA[Coronary artery bypass graft pathway]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3999" net="1">
          <![CDATA[A coronary artery bypass pathway from the heart team decision to rehabilitation: stenting or surgery, consultation, bloods, echocardiogram and carotid scan in parallel with anaemia, valve and carotid findings, admission, sternotomy and artery harvest in parallel with leg vein harvest, anticoagulation, cannulation, cross-clamp and cardioplegia, three distal grafts with flow checks and revisions, reperfusion with fibrillation, weaning from bypass with low output and balloon pump, haemostasis and counts, intensive care with breathing, bleeding and rhythm watched in parallel, ward recovery, cardiac rehabilitation and follow-up.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
