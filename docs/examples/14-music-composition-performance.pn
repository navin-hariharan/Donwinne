      <metadata id="475" net="1">
        <attribute name="Name" id="476" net="1">
          <![CDATA[Three-voice performance engine]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="477" net="1">
          <![CDATA[Melody, bass and drum voices forked at the downbeat and joined at the end of each bar; the melody chooses between two opening notes.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
