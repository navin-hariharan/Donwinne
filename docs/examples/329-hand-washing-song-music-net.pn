      <metadata id="2652" net="1">
        <attribute name="Name" id="2653" net="1">
          <![CDATA[Hand-washing song]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2654" net="1">
          <![CDATA[An original hand-washing jingle for a public health campaign as a music net: a clapped intro, a verse with square-wave melody, triangle bass and claps in parallel, a twenty-second scrubbing chorus with piano melody, sine bass and drums in parallel that can repeat or return to the verse, and a falling rinse outro.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
