  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="3711" net="1">
        <attribute name="Name" id="3712" net="1">
          <![CDATA[Aircraft turnaround at the gate]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="3713" net="1">
          <![CDATA[A full aircraft turnaround on stand: chocks, ground power with APU fallback, jet bridge or stairs, then four parallel streams (deboarding with ambulift assistance, cleaning and catering in parallel; fuelling with lightning suspensions and spill response; technical walkaround with defect repair or MEL deferral, lavatory and water service; hold unloading and loading of three containers each with weighted arcs and late changes), followed by boarding in parallel with cockpit preparation, a loadsheet that is amended by hand or reissued depending on the number of late changes (inhibitor and reset arcs), trim correction, and pushback with tow-bar failures; a lightning alert stops ramp work throughout.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
