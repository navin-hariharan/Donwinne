  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1321" net="1">
        <attribute name="Name" id="1322" net="1">
          <![CDATA[Sugarcane juice stall]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1323" net="1">
          <![CDATA[A street sugarcane juice stall: canes checked for rot and rinsed, three passes through the roller crusher (counted with an inhibitor, cleared with a reset arc) with jams, a bagasse bin that holds three loads before it is emptied, lime and ginger or mint flavouring, straining, serving over ice unless the ice box has run out (inhibitor and read arcs), cash or QR payment, and closing down at night.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
