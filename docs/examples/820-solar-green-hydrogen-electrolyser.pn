  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2073" net="1">
        <attribute name="Name" id="2074" net="1">
          <![CDATA[Solar-powered green hydrogen production]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2075" net="1">
          <![CDATA[Producing green hydrogen with a solar-powered electrolyser: solar forecast, water deionisation with resin regeneration and stack nitrogen purge and warm-up in parallel, energising the rectifier, part load under passing cloud, hydrogen and oxygen handled in parallel (oxygen vented or bottled; hydrogen dried and purity-tested with off-spec venting), compression into storage, hydrogen leak alarms with nitrogen purge, repair and leak test, tube trailer filling with coupling leaks, and the end-of-day purge to standby.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
