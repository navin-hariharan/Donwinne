    <metadataclass count="1" name="General">
      <metadata id="2568" net="1">
        <attribute name="Name" id="2569" net="1">
          <![CDATA[Click and collect grocery order]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2570" net="1">
          <![CDATA[A click and collect grocery order: basket and slot booking, a card pre-authorisation with declines, amendments and cancellations, ambient and chilled picking in parallel with substitutions, short-dated swaps and a fridge alarm, staging, customer notification, no-shows with reminders and restocking in parallel with chilled write-off, check-in, missing bags, age-restricted items with ID checks, substitution review, final payment capture and missing-item refunds.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
