  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="2442" net="1">
        <attribute name="Name" id="2443" net="1">
          <![CDATA[Plant-based burger production line]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2444" net="1">
          <![CDATA[A meat-free burger line: soy allergen residue from the previous run forces a deep clean and swab before starting (inhibitor and read arcs), then protein texturising by high-moisture extrusion with an adjustment counter that escalates to a process engineer (reset arc), coconut fat emulsion and beet-coloured flavour premix in parallel, dough mixing and chilling, forming three patties that freeze in a tunnel blocked by refrigeration alarms, tray sealing, allergen labelling that follows the recipe used, label vision checks, lab hold and release, and an end-of-run residue flag after soy runs.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
</Snoopy>
