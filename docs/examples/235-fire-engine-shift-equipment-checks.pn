      <metadata id="2399" net="1">
        <attribute name="Name" id="2400" net="1">
          <![CDATA[Fire engine equipment checks at shift change]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="2401" net="1">
          <![CDATA[A fire station shift: handover with reported defects, then the driver, breathing-apparatus wearer, equipment rider and officer check the engine and pump, SCBA sets, ladders, generator, lighting and rescue tools, radios, thermal camera and defibrillator in parallel with faults and replacements, sign-off, weekly hose testing, incidents, drills and hydrant inspections before the next handover.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
