  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1484" net="1">
        <attribute name="Name" id="1485" net="1">
          <![CDATA[Readers-writers lock with writer preference]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1486" net="1">
          <![CDATA[Three reader threads and two writer threads sharing a database table through a readers-writers lock: readers take the shared lock only when no writer holds or waits for it (inhibitor arcs) and back off otherwise, can answer from a cached snapshot, writers wait for readers to drain or time out, write the WAL with fsync retries, update the table, index and cache in parallel with a cache invalidation (reset arc), roll back on violations, and may downgrade to a shared lock to verify their commit.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
    <metadataclass count="0" name="Comment"/>
    <metadataclass count="0" name="Constant Class"/>
    <metadataclass count="0" name="Function Class"/>
  </metadataclasses>
