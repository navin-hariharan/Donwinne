    <metadataclass count="1" name="General">
      <metadata id="1444" net="1">
        <attribute name="Name" id="1445" net="1">
          <![CDATA[Lease operator's pump jack well round]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1446" net="1">
          <![CDATA[A lease operator's daily round of onshore pump jack wells: driving the route, stopped units with controller resets or a workover request, stuffing box, belt and tank checks in parallel with repacking, a locked-out belt change, crude pickups and water hauls, recording readings, more wells or the end of the route, and the daily production report with engineer queries.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
