    <metadataclass count="1" name="General">
      <metadata id="1556" net="1">
        <attribute name="Name" id="1557" net="1">
          <![CDATA[Smart irrigation system]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1558" net="1">
          <![CDATA[A smart irrigation controller: soil moisture rises with rain and irrigation and falls in dry weather, sensor faults and recalibration, watering skipped when the soil is moist or rain is forecast, rain gauge fallback when the weather API is down, pump interlock, two zones watered in parallel with a sticking valve, leak detection and a rain sensor, usage logging and leak alerts cleared by a reset arc.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
