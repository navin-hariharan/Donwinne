  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1881" net="1">
        <attribute name="Name" id="1882" net="1">
          <![CDATA[Lo-fi beat for coding]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1883" net="1">
          <![CDATA[An original lo-fi beat for a coding session as a music net: a piano intro, a groove where piano chords, a triangle bass line and drums play in parallel and can repeat, a sine-lead keyboard solo, a tense square-wave bug-hunt bridge that returns to the groove, and an outro ending in a build-passed chime before the session starts again.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
