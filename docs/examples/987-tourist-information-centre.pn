  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1642" net="1">
        <attribute name="Name" id="1643" net="1">
          <![CDATA[Tourist information centre]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1644" net="1">
          <![CDATA[A tourist information centre with three visitors and two advisors: leaflets taken from the rack and restocked, interpreter calls, directions, accommodation searches with a call to the next village while the visitor browses brochures, show tickets with sold-out shows and returns lists, card or cash payments, found and lost property, complaints, follow-up questions, and feedback on the way out.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
