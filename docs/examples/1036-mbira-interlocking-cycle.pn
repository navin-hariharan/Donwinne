  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1496" net="1">
        <attribute name="Name" id="1497" net="1">
          <![CDATA[Mbira interlocking cycle]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1498" net="1">
          <![CDATA[An original mbira piece in G: the instrument is placed in its gourd resonator, a kushaura phrase leads into a cycle where kushaura, kutsinhira and hosho shakers play in parallel and may repeat, a high variation on the upper keys returns to the cycle, and a fading ending leads back to the start.]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
