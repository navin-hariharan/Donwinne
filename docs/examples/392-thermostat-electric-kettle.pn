  <metadataclasses count="4">
    <metadataclass count="1" name="General">
      <metadata id="1425" net="1">
        <attribute name="Name" id="1426" net="1">
          <![CDATA[Thermostat-controlled electric kettle]]>
          <graphics count="0"/>
        </attribute>
        <attribute name="Description" id="1427" net="1">
          <![CDATA[An electric kettle with a bimetallic thermostat: filling up to four cups, base contact and wall socket checks (inhibitor arc), a temperature level that climbs to boiling while the element has water (read arcs), steam bending the bimetallic strip to switch off, a lid left open that stops the auto switch-off, boil-dry protection when the kettle is empty, making a mug in parallel with heating, pouring cup by cup, cooling between uses, and limescale that builds with each boil until the kettle is descaled (reset arc).]]>
          <graphics count="0"/>
        </attribute>
        <graphics count="0"/>
      </metadata>
    </metadataclass>
